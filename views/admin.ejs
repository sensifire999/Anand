<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxeStore | Admin Command Center</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary: #3b82f6; --success: #10b981; --danger: #ef4444; --warning: #f59e0b; --bg: #0b0f1a; --card-bg: #161b2c; --text: #ffffff; --text-dim: #94a3b8; }
        body { background-color: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; margin: 0; padding: 15px; }
        
        .header { display: flex; justify-content: space-between; align-items: center; padding: 20px 0; border-bottom: 1px solid #2d3748; margin-bottom: 25px; }
        .header h1 { font-size: 1.3rem; letter-spacing: 2px; text-transform: uppercase; margin: 0; }
        .signout-btn { background: var(--danger); color: white; padding: 8px 15px; border-radius: 8px; text-decoration: none; font-size: 0.7rem; font-weight: bold; }

        .stats-container { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 30px; }
        .stat-box { background: var(--card-bg); padding: 15px; border-radius: 18px; border: 1px solid #2d3748; text-align: center; }
        .stat-box p { color: var(--text-dim); margin: 0; font-size: 0.7rem; text-transform: uppercase; }
        .stat-box h2 { margin: 5px 0 0 0; font-size: 1.4rem; color: var(--primary); }

        .section-title { font-size: 1rem; font-weight: 700; margin: 25px 0 15px 0; text-transform: uppercase; color: var(--primary); border-left: 4px solid var(--primary); padding-left: 10px; }

        /* --- ORDER CARD --- */
        .order-card { background: var(--card-bg); border-radius: 20px; padding: 18px; margin-bottom: 20px; border: 1px solid #2d3748; position: relative; }
        .customer-name { font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 5px; }
        .customer-info { font-size: 0.85rem; color: var(--text-dim); margin-bottom: 12px; line-height: 1.5; }
        
        .items-box { background: rgba(0,0,0,0.3); border-radius: 12px; padding: 12px; margin-bottom: 12px; border: 1px solid #2d3748; }
        .item-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid #2d3748; font-size: 0.8rem; }
        .item-row:last-child { border: none; }

        .status-label { font-size: 0.7rem; font-weight: bold; color: var(--text-dim); margin-bottom: 5px; display: block; }
        .status-select { background: #0b0f1a; color: white; border: 1px solid var(--primary); padding: 10px; border-radius: 10px; font-size: 0.85rem; width: 100%; font-weight: bold; outline: none; }
        
        /* Status Colors */
        .status-select option { background: #161b2c; }

        /* --- PRODUCT INVENTORY --- */
        .admin-form { background: var(--card-bg); padding: 20px; border-radius: 20px; border: 1px solid #2d3748; margin-top: 20px; }
        input, textarea { width: 100%; background: #0b0f1a; border: 1px solid #2d3748; padding: 12px; border-radius: 10px; color: white; margin-bottom: 10px; box-sizing: border-box; font-size: 0.9rem; }
        .submit-btn { background: var(--primary); color: white; width: 100%; padding: 12px; border: none; border-radius: 10px; font-weight: 800; cursor: pointer; }

        .product-list-item { display: flex; align-items: center; justify-content: space-between; background: rgba(0,0,0,0.2); padding: 10px; border-radius: 12px; margin-bottom: 8px; border: 1px solid #2d3748; }
        .prod-img { width: 45px; height: 45px; border-radius: 8px; object-fit: cover; border: 1px solid var(--primary); }
        .del-icon { color: var(--danger); font-size: 1.1rem; cursor: pointer; padding: 5px; }
    </style>
</head>
<body>

    <div class="header">
        <h1>LUXE<span style="color: var(--primary);">ADMIN</span></h1>
        <a href="/logout" class="signout-btn">LOGOUT</a>
    </div>

    <div class="stats-container">
        <div class="stat-box">
            <p>Revenue</p>
            <h2>₹<%= stats.sales %></h2>
        </div>
        <div class="stat-box">
            <p>Orders</p>
            <h2><%= stats.ordersCount %></h2>
        </div>
    </div>

    <div class="section-title">Order Management</div>
    <% if(orders && orders.length > 0) { %>
        <% orders.forEach(order => { %>
            <div class="order-card" id="card-<%= order.id %>">
                <div style="display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--primary); font-weight: 800; margin-bottom: 8px;">
                    <span>ORDER #<%= order.id %></span>
                    <span><%= order.date %></span>
                </div>
                <div class="customer-name"><%= order.fullname %></div>
                <div class="customer-info">
                    <i class="fa fa-phone"></i> <strong><%= order.phone %></strong> <br>
                    <i class="fa fa-map-marker-alt"></i> <%= order.address %> <br>
                    <span style="color: var(--warning); font-weight: bold;">UTR: <%= order.utr %></span>
                </div>

                <div class="items-box">
                    <span style="font-size: 0.7rem; color: var(--primary); font-weight: bold; display: block; margin-bottom: 5px;">ITEMS</span>
                    <% order.items.forEach(item => { %>
                        <div class="item-row">
                            <span><%= item.name %></span>
                            <span style="font-weight: 700;">₹<%= item.price %></span>
                        </div>
                    <% }) %>
                    <div style="text-align: right; margin-top: 10px; font-weight: 900; color: var(--success); font-size: 1.1rem;">
                        Total: ₹<%= order.totalPrice %>
                    </div>
                </div>

                <span class="status-label">UPDATE ORDER STATUS:</span>
                <select class="status-select" onchange="updateStatus('<%= order.id %>', this.value)" 
                        style="border-color: <%= order.status.includes('DELIVERED') ? '#10b981' : (order.status.includes('CANCELLED') ? '#ef4444' : '#3b82f6') %>">
                    <option value="🕒 PENDING" <%= order.status === '🕒 PENDING' ? 'selected' : '' %>>🕒 PENDING</option>
                    <option value="✅ SHIPPED" <%= order.status === '✅ SHIPPED' ? 'selected' : '' %>>✅ SHIPPED</option>
                    <option value="🚚 DELIVERED" <%= order.status === '🚚 DELIVERED' ? 'selected' : '' %>>🚚 DELIVERED</option>
                    <option value="❌ CANCELLED" <%= order.status === '❌ CANCELLED' ? 'selected' : '' %>>❌ CANCELLED</option>
                </select>
            </div>
        <% }) %>
    <% } else { %>
        <p style="text-align: center; color: var(--text-dim); padding: 40px 0;">No orders found.</p>
    <% } %>

    <div class="section-title">Inventory Control</div>
    <div class="admin-form">
        <form action="/admin/add-product" method="POST">
            <input type="text" name="name" placeholder="Product Name" required>
            <input type="number" name="price" placeholder="Price" required>
            <input type="text" name="images" placeholder="Image URL (Direct link)" required>
            <textarea name="desc" placeholder="Product details..." rows="2"></textarea>
            <button type="submit" class="submit-btn">ADD TO STORE</button>
        </form>

        <div style="margin-top: 25px;">
            <p style="font-size: 0.8rem; color: var(--primary); font-weight: 800; margin-bottom: 10px;">STOCK LIST</p>
            <% if(products && products.length > 0) { %>
                <% products.forEach(p => { %>
                    <div class="product-list-item">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <img src="<%= p.images[0] %>" class="prod-img">
                            <div>
                                <div style="font-size: 0.85rem; font-weight: 700;"><%= p.name %></div>
                                <div style="font-size: 0.8rem; color: var(--success);">₹<%= p.price %></div>
                            </div>
                        </div>
                        <i class="fas fa-trash-alt del-icon" onclick="deleteProduct('<%= p.id %>')"></i>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script>
        async function updateStatus(orderId, status) {
            const res = await fetch('/admin/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, status })
            });
            if(res.ok) {
                // UI update feedback
                location.reload(); 
            }
        }

        async function deleteProduct(id) {
            if(!confirm('Pakka delete karna hai?')) return;
            const res = await fetch('/admin/delete-product', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            if(res.ok) location.reload();
        }
    </script>
</body>
</html>

